# Application Settings
APP_NAME="Enterprise Employee Attrition Prediction System"
ENVIRONMENT="development"
DEBUG=True
API_HOST="127.0.0.1"
API_PORT=8000

# Database Configuration
# Options for DB_ENGINE: "sqlserver" or "sqlite"
DB_ENGINE="sqlserver"
DB_SERVER="localhost"
DB_NAME="EmployeeAttritionDB"
DB_USER="sa"
DB_PASSWORD="YourStrongPassword123!"
DB_DRIVER="ODBC Driver 17 for SQL Server"
# Trust server certificate (useful for local SQL Server development)
DB_TRUST_SERVER_CERTIFICATE=True
# SQLite Fallback Path (used automatically if DB_ENGINE="sqlite" or if SQL Server connection fails in dev)
SQLITE_DB_PATH="data/attrition_system.db"

# ML & Artifact Settings
ARTIFACTS_DIR="artifacts"
MODEL_FILE_NAME="model.joblib"
PREPROCESSOR_FILE_NAME="preprocessor.joblib"
METRICS_FILE_NAME="metrics.json"

# Attrition Risk Classification Thresholds
RISK_THRESHOLD_LOW=0.30   # Attrition prob < 0.30 -> Low Risk
RISK_THRESHOLD_HIGH=0.60  # Attrition prob > 0.60 -> High Risk (0.30 - 0.60 -> Medium Risk)

# Logging Settings
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/app.log"
